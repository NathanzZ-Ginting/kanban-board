# ==========================================
# ENVIRONMENT
# ==========================================
NODE_ENV=development
GO_ENV=development

# ==========================================
# FRONTEND
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_BOARD_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_TASK_SERVICE_URL=http://localhost:8004

# ==========================================
# BACKEND - COMMON
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# DATABASE - MONGODB
# ==========================================
MONGODB_URI=mongodb://kanban_user:kanban_pass@localhost:27017
MONGODB_DATABASE=kanban_db
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# ==========================================
# AUTH SERVICE
# ==========================================
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_HOST=0.0.0.0

# ==========================================
# USER SERVICE
# ==========================================
USER_SERVICE_PORT=8002
USER_SERVICE_HOST=0.0.0.0

# ==========================================
# BOARD SERVICE
# ==========================================
BOARD_SERVICE_PORT=8003
BOARD_SERVICE_HOST=0.0.0.0

# ==========================================
# TASK SERVICE
# ==========================================
TASK_SERVICE_PORT=8004
TASK_SERVICE_HOST=0.0.0.0

# ==========================================
# REDIS (Optional - for caching)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
LOG_FORMAT=json
